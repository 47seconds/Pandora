server {
    listen 80;
    listen [::]:80;
    server_name dozzle.vocallabs.ai dozzle-dev.vocallabs.ai;
    error_log  /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;

    location / {
        # Basic authentication
        auth_basic "Dozzle Login";
        auth_basic_user_file /etc/nginx/.htpasswd;
        
        proxy_pass http://127.0.0.1:9999;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        # Pass auth headers to Dozzle
        proxy_set_header Remote-User $remote_user;
        proxy_set_header Remote-Email "$remote_user@subspace.money";
        proxy_set_header Remote-Name $remote_user;
    }

}

