PANDORA_ADDR=:87471
PANDORA_DB_PATH=./data/pandora.db
PANDORA_WEBHOOK_SECRET=change-me          # same value as the GitHub webhook / workflow secret
PANDORA_GITHUB_TOKEN=ghp_xxx              # needs PR read, commit statuses, PR comments
PANDORA_JWT_SECRET=                       # REQUIRED, min 32 chars: openssl rand -hex 32
PANDORA_JWT_TTL_HOURS=24
PANDORA_BOOTSTRAP_ADMIN_EMAIL=            # this email becomes admin on signup; empty = first signup is admin
PANDORA_SIGNUP_DOMAINS=vocallabs.ai       # allowed signup email domains, comma list (empty = anyone)
PANDORA_ALLOWED_REPOS=                    # comma list, e.g. org/eva,org/forge (empty = all)
PANDORA_REVIEW_PROVIDER=anthropic         # anthropic | mock
ANTHROPIC_API_KEY=
PANDORA_REVIEW_MODEL=claude-sonnet-5-5
PANDORA_MAX_DIFF_BYTES=200000
PANDORA_REVIEW_TIMEOUT_SEC=300
