# Comments go on their own line (never after a value).

PANDORA_ADDR=:8847
PANDORA_DB_PATH=./data/pandora.db

# Same value as the secret in each repo's workflow/webhook.
PANDORA_WEBHOOK_SECRET=change-me
# GitHub App (preferred). App ID is on the app's settings page.
PANDORA_GITHUB_APP_ID=
# The .pem you generated for the app, on ONE line with literal \n between lines.
# (Or set PANDORA_GITHUB_APP_PRIVATE_KEY_FILE to a path inside the container.)
PANDORA_GITHUB_APP_PRIVATE_KEY=
# Dev-only fallback when no App is configured. Leave empty in production.
PANDORA_GITHUB_TOKEN=

# Where users reach Pandora (no trailing slash). The GitHub login callback is <this>/auth/github/callback.
PANDORA_PUBLIC_URL=https://pandora-dev.vocallabs.ai

# "Sign in with GitHub": the GitHub App's client id and a client secret generated on its settings page.
PANDORA_GITHUB_CLIENT_ID=
PANDORA_GITHUB_CLIENT_SECRET=
# GitHub username that is always an admin (so the first admin exists). Everyone else starts as pending.
PANDORA_BOOTSTRAP_ADMIN_GITHUB=

# REQUIRED, min 32 chars: openssl rand -hex 32
PANDORA_JWT_SECRET=
PANDORA_JWT_TTL_HOURS=24

# How many days of PRs the admin backfill pulls from GitHub.
PANDORA_BACKFILL_DAYS=90

# Comma list, e.g. org/eva,org/forge. Empty = all repos.
PANDORA_ALLOWED_REPOS=

# anthropic | openrouter | mock
PANDORA_REVIEW_PROVIDER=openrouter
# anthropic: key starting sk-ant-   |   openrouter: key starting sk-or-
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Blank = default (anthropic: claude-sonnet-5-5, openrouter: anthropic/claude-sonnet-5.5).
PANDORA_REVIEW_MODEL=
PANDORA_MAX_DIFF_BYTES=200000
PANDORA_REVIEW_TIMEOUT_SEC=300

# Dashboard files served at /dashboard/ (empty = off).
PANDORA_STATIC_DIR=./static
